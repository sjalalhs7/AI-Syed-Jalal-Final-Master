PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# Change this only if the deployed frontend uses a different HTTPS origin.
CORS_ORIGIN=https://ai-syed-jalal-live.pages.dev
AUTH_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
CSRF_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=true
# Docker Compose's bundled Postgres is on the private container network; use true for managed Postgres with valid TLS.
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Configure at least one real provider for live AI execution. Never commit real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_ENABLE_GOOGLE_SEARCH=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
OMNIROUTE_KEY=
OMNIROUTE_MODEL=auto
# Set OMNIROUTE_URL to the actual reachable service endpoint if OmniRoute is used.
OMNIROUTE_URL=http://localhost:20128
