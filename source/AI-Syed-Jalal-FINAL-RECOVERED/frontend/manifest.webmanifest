{
  "id": "./",
  "name": "AI-Syed Jalal — Professional AI Workspace",
  "short_name": "AI-Syed Jalal",
  "description": "Professional AI workspace for chat, research, coding, data analysis, documents and AI agents.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "minimal-ui"],
  "orientation": "any",
  "background_color": "#06101d",
  "theme_color": "#07101f",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/app-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/approved-sj-rainbow-crown.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "assets/app-shots/home-wide.jpg",
      "sizes": "1600x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "The homepage: sign in, choose a surface, or open the 1-minute guide."
    },
    {
      "src": "assets/app-shots/jalalai-wide.jpg",
      "sizes": "1600x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "JalalAi: plan, calculate and organize with local tools that need no AI key."
    },
    {
      "src": "assets/app-shots/notes-wide.jpg",
      "sizes": "1600x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Quick Notes: write a note, save it to your private workspace, or share a file into it."
    },
    {
      "src": "assets/app-shots/arena-wide.jpg",
      "sizes": "1600x900",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Arena: blind battles between engines with a deterministic rubric judge."
    },
    {
      "src": "assets/app-shots/home-narrow.jpg",
      "sizes": "900x1600",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "The homepage on a phone, ready to install to the home screen."
    },
    {
      "src": "assets/app-shots/notes-narrow.jpg",
      "sizes": "900x1600",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Quick Notes on a phone: one tap from the home screen to a new note."
    }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "New note",
      "description": "Open Quick Notes with a blank note ready to type.",
      "url": "./notes.html?new=1",
      "icons": [
        {
          "src": "assets/app-icons/shortcut-note-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start here",
      "short_name": "Guide",
      "description": "The one-minute guide to every working surface.",
      "url": "./guide.html",
      "icons": [
        {
          "src": "assets/app-icons/shortcut-guide-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Workspace",
      "short_name": "Workspace",
      "description": "Records, documents, AI command and settings.",
      "url": "./workspace.html",
      "icons": [
        {
          "src": "assets/app-icons/shortcut-workspace-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Arena",
      "short_name": "Arena",
      "description": "Blind battles between engines with a rubric judge.",
      "url": "./arena.html",
      "icons": [
        {
          "src": "assets/app-icons/shortcut-arena-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./notes.html?opened=file",
      "accept": {
        "text/plain": [".txt"],
        "text/markdown": [".md", ".markdown"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+ajalal",
      "url": "./protocol.html?url=%s"
    }
  ],
  "share_target": {
    "action": "./share-target.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "./notes.html?new=1"
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "./index.html" }
      ]
    },
    "new_tab_button": {
      "url": "./notes.html?new=1"
    }
  },
  "widgets": [
    {
      "name": "Alsyed Jalal — New note",
      "short_name": "New note",
      "description": "Start a note in your private workspace, or open the last one you saved.",
      "tag": "aj-new-note",
      "template": "aj-new-note",
      "ms_ac_template": "./widgets/new-note-template.json",
      "data": "./widgets/widget-data.json",
      "type": "application/json",
      "auth": false,
      "update": 3600,
      "multiple": false,
      "icons": [
        { "src": "./assets/app-icons/widget-16.png", "sizes": "16x16", "type": "image/png" },
        { "src": "./assets/app-icons/widget-48.png", "sizes": "48x48", "type": "image/png" }
      ],
      "screenshots": [
        {
          "src": "./widgets/new-note-preview.png",
          "sizes": "600x400",
          "type": "image/png",
          "label": "The New note widget on the Windows widgets board",
          "platform": "windows"
        }
      ]
    }
  ]
}
