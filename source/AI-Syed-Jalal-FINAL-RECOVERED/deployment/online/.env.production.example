# Copy to .env.production and fill values locally. Never commit .env.production.
PUBLIC_ORIGIN=https://YOUR-DOMAIN.example
DATABASE_URL=postgresql://USER:PASSWORD@NEON-HOST/DBNAME?sslmode=require
CSRF_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES
SESSION_TTL_HOURS=8
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# Add at least one provider key for live AI. Keep public website chat disabled by default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
OMNIROUTE_KEY=
OMNIROUTE_URL=
PUBLIC_CHAT_ENABLED=false
PUBLIC_CHAT_DAILY_MAX=300
PUBLIC_CHAT_PROVIDER=deepseek
